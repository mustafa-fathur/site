---
/**
 * Abstract thumbnail for a blog post, drawn at build time from a hash of `seed`
 * so every post gets its own stable pattern without any image file. Shapes use
 * `currentColor`, so the pattern follows the theme.
 */
interface Props {
  seed: string;
  class?: string;
}

const { seed, class: className } = Astro.props;

const COLS = 4;
const ROWS = 3;
const CELL = 40;
const OPACITIES = [0.1, 0.18, 0.3, 0.55, 0.85];
const SHAPES = ["quarter", "quarter", "quarter", "circle", "ring", "square", "blank"] as const;

/** FNV-1a */
function hash(text: string): number {
  let h = 0x811c9dc5;
  for (let i = 0; i < text.length; i++) {
    h ^= text.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return h >>> 0;
}

/** mulberry32 */
function prng(state: number): () => number {
  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = prng(hash(seed));
const pick = <T,>(items: readonly T[]): T => items[Math.floor(random() * items.length)] as T;

/** A quarter disc filling the cell, anchored on one of its four corners. */
function quarter(x: number, y: number, corner: number): string {
  const c = CELL;
  const paths = [
    `M${x} ${y}h${c}a${c} ${c} 0 0 1 ${-c} ${c}z`,
    `M${x + c} ${y}v${c}a${c} ${c} 0 0 1 ${-c} ${-c}z`,
    `M${x + c} ${y + c}h${-c}a${c} ${c} 0 0 1 ${c} ${-c}z`,
    `M${x} ${y + c}v${-c}a${c} ${c} 0 0 1 ${c} ${c}z`,
  ];
  return `<path d="${paths[corner % 4]}"`;
}

const shapes: string[] = [];
for (let row = 0; row < ROWS; row++) {
  for (let col = 0; col < COLS; col++) {
    const x = col * CELL;
    const y = row * CELL;
    const shape = pick(SHAPES);
    const opacity = pick(OPACITIES);
    const corner = Math.floor(random() * 4);
    const half = CELL / 2;

    if (shape === "quarter") shapes.push(`${quarter(x, y, corner)} fill-opacity="${opacity}"/>`);
    if (shape === "circle")
      shapes.push(`<circle cx="${x + half}" cy="${y + half}" r="${half - 4}" fill-opacity="${opacity}"/>`);
    if (shape === "ring")
      shapes.push(
        `<circle cx="${x + half}" cy="${y + half}" r="${half - 8}" fill="none" stroke="currentColor" stroke-width="6" stroke-opacity="${opacity}"/>`,
      );
    if (shape === "square")
      shapes.push(`<rect x="${x}" y="${y}" width="${CELL}" height="${CELL}" fill-opacity="${opacity}"/>`);
  }
}
---

<svg
  viewBox={`0 0 ${COLS * CELL} ${ROWS * CELL}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  fill="currentColor"
  class:list={["border border-card-line bg-background-1 text-foreground", className]}
  set:html={shapes.join("")}
/>
