---
import type { HTMLAttributes } from "astro/types";
import { button, type ButtonOptions } from "../lib/ui";

interface Props extends HTMLAttributes<"a">, ButtonOptions {
  href: string;
  /** Opens in a new tab, and says so to screen readers. */
  external?: boolean;
}

const { variant, size, pill, external = false, class: className, ...attrs } = Astro.props;
---

<a
  class:list={[button({ variant, size, pill }), className]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  {...attrs}
>
  <slot />
  {external && <span class="sr-only">(opens in a new tab)</span>}
</a>
