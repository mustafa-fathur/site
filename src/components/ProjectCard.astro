---
import type { ProjectItem } from "../data/projects";
import { brandIcon } from "../lib/brand-icons";
import Icon from "./Icon.astro";
import ProjectModal from "./ProjectModal.astro";

interface Props {
  item: ProjectItem;
  /**
   * `tile`: the image alone, opening the project screenshot modal. For the home page.
   * `card`: image, year, title, context, summary, stack and links.
   */
  variant?: "tile" | "card";
  headingLevel?: 2 | 3;
  /** Anchor id, for `/projects#<slug>` links. */
  id?: string;
}

const { item, variant = "card", headingLevel = 2, id } = Astro.props;
const Heading = `h${headingLevel}` as const;
const preview = item.devicePreview;

// The generated SVG mockups are drawn with their own margins on a transparent
// canvas, so they are shown whole. A real screenshot or photo fills the frame.
const fit = item.image.endsWith(".svg") ? "object-contain" : "object-cover";
---

{
  variant === "tile" ? (
    <>
      <button
        type="button"
        data-project-modal-open={item.slug}
        aria-haspopup="dialog"
        aria-controls={`project-modal-${item.slug}`}
        title={item.title}
        class="group relative block w-full aspect-16/10 overflow-hidden rounded-xl text-start"
      >
        {preview?.mobile ? (
          /* 1. Web + Mobile composite tile (NeoCentral SI) — edge-to-edge on background */
          <svg
            viewBox="0 0 640 400"
            role="img"
            aria-label={item.title}
            class="size-full object-contain"
          >
            <defs>
              <clipPath id={`${item.slug}-web-clip`}>
                <path d="M1 58.5h456V360a11 11 0 0 1-11 11H12a11 11 0 0 1-11-11Z" />
              </clipPath>
              <clipPath id={`${item.slug}-mobile-clip`}>
                <rect x="481" y="40" width="152" height="323" rx="16" />
              </clipPath>
            </defs>

            {/* Browser frame */}
            <rect x="0" y="28" width="458" height="344" rx="12" fill="#6a7282" fill-opacity="0.08" />
            <circle cx="18" cy="43" r="4" fill="#6a7282" fill-opacity="0.45" />
            <circle cx="32" cy="43" r="4" fill="#6a7282" fill-opacity="0.3" />
            <circle cx="46" cy="43" r="4" fill="#6a7282" fill-opacity="0.2" />
            <rect x="72" y="35" width="314" height="16" rx="8" fill="#6a7282" fill-opacity="0.12" />
            <image
              href={preview.web}
              x="1"
              y="58.5"
              width="456"
              height="312.5"
              preserveAspectRatio="xMidYMid slice"
              clip-path={`url(#${item.slug}-web-clip)`}
            />
            <line x1="0" y1="58.5" x2="458" y2="58.5" stroke="#6a7282" stroke-opacity="0.25" />
            <rect x="0.5" y="28.5" width="457" height="343" rx="12" fill="none" stroke="#6a7282" stroke-opacity="0.35" />

            {/* Phone frame */}
            <rect x="474" y="28" width="166" height="344" rx="22" fill="#6a7282" fill-opacity="0.08" />
            <rect x="539" y="32.5" width="36" height="4" rx="2" fill="#6a7282" fill-opacity="0.35" />
            <image
              href={preview.mobile}
              x="481"
              y="25.5"
              width="154"
              height="354"
              preserveAspectRatio="none"
              clip-path={`url(#${item.slug}-mobile-clip)`}
            />
            <rect x="481" y="40" width="152" height="323" rx="16" fill="none" stroke="#6a7282" stroke-opacity="0.2" />
            <rect x="474.5" y="28.5" width="165" height="343" rx="22" fill="none" stroke="#6a7282" stroke-opacity="0.35" />
          </svg>
        ) : preview?.webSecondary ? (
          /* 2. Dual cascaded web windows tile (BookMySpace // FTIRoom) — edge-to-edge on background */
          <svg
            viewBox="0 0 640 400"
            role="img"
            aria-label={item.title}
            class="size-full object-contain"
          >
            <defs>
              <clipPath id={`${item.slug}-back-clip`}>
                <path d="M1 30.5h474V284a11 11 0 0 1-11 11H12a11 11 0 0 1-11-11Z" />
              </clipPath>
              <clipPath id={`${item.slug}-front-clip`}>
                <path d="M165 134.5h474V388a11 11 0 0 1-11 11H176a11 11 0 0 1-11-11Z" />
              </clipPath>
            </defs>

            {/* Back window: BookMySpace */}
            <rect x="0" y="0" width="476" height="296" rx="12" fill="#6a7282" fill-opacity="0.08" />
            <circle cx="17" cy="15" r="3.5" fill="#6a7282" fill-opacity="0.45" />
            <circle cx="30" cy="15" r="3.5" fill="#6a7282" fill-opacity="0.3" />
            <circle cx="43" cy="15" r="3.5" fill="#6a7282" fill-opacity="0.2" />
            <rect x="68" y="8" width="340" height="14" rx="7" fill="#6a7282" fill-opacity="0.12" />
            <image
              href={preview.web}
              x="1"
              y="30.5"
              width="474"
              height="264.5"
              preserveAspectRatio="xMidYMin slice"
              clip-path={`url(#${item.slug}-back-clip)`}
            />
            <line x1="0" y1="30.5" x2="476" y2="30.5" stroke="#6a7282" stroke-opacity="0.25" />
            <rect x="0.5" y="0.5" width="475" height="295" rx="12" fill="none" stroke="#6a7282" stroke-opacity="0.35" />

            {/* Front window: FTIRoom */}
            <rect x="164" y="104" width="476" height="296" rx="12" fill="#262626" />
            <rect x="164" y="104" width="476" height="296" rx="12" fill="#ffffff" fill-opacity="0.92" />
            <circle cx="181" cy="119" r="3.5" fill="#6a7282" fill-opacity="0.45" />
            <circle cx="194" cy="119" r="3.5" fill="#6a7282" fill-opacity="0.3" />
            <circle cx="207" cy="119" r="3.5" fill="#6a7282" fill-opacity="0.2" />
            <rect x="232" y="112" width="340" height="14" rx="7" fill="#6a7282" fill-opacity="0.14" />
            <image
              href={preview.webSecondary}
              x="165"
              y="134.5"
              width="474"
              height="264.5"
              preserveAspectRatio="xMidYMin slice"
              clip-path={`url(#${item.slug}-front-clip)`}
            />
            <line x1="164" y1="134.5" x2="640" y2="134.5" stroke="#6a7282" stroke-opacity="0.25" />
            <rect x="164.5" y="104.5" width="475" height="295" rx="12" fill="none" stroke="#6a7282" stroke-opacity="0.45" />
          </svg>
        ) : preview?.web ? (
          /* 3. Single web browser window tile — fills full 640x400 with no outer box */
          <svg
            viewBox="0 0 640 400"
            role="img"
            aria-label={item.title}
            class="size-full object-contain"
          >
            <defs>
              <clipPath id={`${item.slug}-single-clip`}>
                <path d="M1 34.5h638V388a11 11 0 0 1-11 11H12a11 11 0 0 1-11-11Z" />
              </clipPath>
            </defs>

            <rect x="0" y="0" width="640" height="400" rx="12" fill="#6a7282" fill-opacity="0.08" />
            <circle cx="18" cy="17" r="4" fill="#6a7282" fill-opacity="0.45" />
            <circle cx="32" cy="17" r="4" fill="#6a7282" fill-opacity="0.3" />
            <circle cx="46" cy="17" r="4" fill="#6a7282" fill-opacity="0.2" />
            <rect x="74" y="9" width="492" height="16" rx="8" fill="#6a7282" fill-opacity="0.12" />
            <image
              href={preview.web}
              x="1"
              y="34.5"
              width="644"
              height="364.5"
              preserveAspectRatio="xMidYMin slice"
              clip-path={`url(#${item.slug}-single-clip)`}
            />
            <line x1="0" y1="34.5" x2="640" y2="34.5" stroke="#6a7282" stroke-opacity="0.25" />
            <rect x="0.5" y="0.5" width="639" height="399" rx="12" fill="none" stroke="#6a7282" stroke-opacity="0.35" />
          </svg>
        ) : (
          <img
            src={item.image}
            alt={item.title}
            width="640"
            height="400"
            loading="lazy"
            decoding="async"
            class:list={["size-full", fit]}
          />
        )}
        <span
          aria-hidden="true"
          class="absolute inset-0 flex items-end rounded-xl bg-linear-to-t from-black/75 to-black/0 to-50% p-3.5 text-sm font-medium text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
        >
          {item.title}
        </span>
      </button>
      <ProjectModal item={item} />
    </>
  ) : (
    <article id={id} class="flex flex-col rounded-lg border border-card-line">
      <div class="relative aspect-16/10 overflow-hidden rounded-t-lg border-b border-card-line bg-background-1">
        <img
          src={preview?.web ?? item.image}
          alt={`Preview of ${item.title}`}
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
          class:list={["size-full object-top", preview?.web ? "object-cover" : fit]}
        />
      </div>

      <div class="flex grow flex-col p-4">
        <div class="flex items-center justify-between gap-x-2">
          <p class="text-xs">{item.year}</p>
          <div class="flex items-center gap-x-2.5">
            {item.repos && item.repos.length > 1 ? (
              <div class="relative" data-card-repo-menu>
                <button
                  type="button"
                  data-card-repo-toggle
                  aria-expanded="false"
                  aria-haspopup="menu"
                  class="inline-flex items-center justify-center rounded-sm text-muted-foreground-1 transition-colors hover:text-foreground"
                  title="GitHub repositories"
                >
                  <Icon name="github" class="size-3.5 shrink-0" />
                  <span class="sr-only">GitHub repositories for {item.title}</span>
                </button>
                <div
                  role="menu"
                  data-card-repo-panel
                  class="hidden absolute inset-e-0 top-full z-20 mt-1.5 min-w-40 rounded-xl border border-card-line bg-background p-1 shadow-lg"
                >
                  {item.repos.map((repo) => (
                    <a
                      role="menuitem"
                      href={repo.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center justify-between gap-x-3 rounded-lg px-2.5 py-1.5 text-xs font-medium text-muted-foreground-1 transition-colors hover:bg-muted-hover hover:text-foreground"
                    >
                      <span>{repo.label}</span>
                      <span aria-hidden="true" class="text-muted-foreground-2">↗</span>
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              item.repo && (
                <a
                  href={item.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-sm text-muted-foreground-1 transition-colors hover:text-foreground"
                  title="GitHub repository"
                >
                  <Icon name="github" class="size-3.5 shrink-0" />
                  <span class="sr-only">Repository of {item.title} (opens in a new tab)</span>
                </a>
              )
            )}
            {item.url && (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-sm text-muted-foreground-1 transition-colors hover:text-foreground"
                title="Live website"
              >
                <Icon name="globe" class="size-3.5 shrink-0" />
                <span class="sr-only">Live website of {item.title} (opens in a new tab)</span>
              </a>
            )}
          </div>
        </div>

        <Heading class="mt-1 font-medium text-foreground">{item.title}</Heading>
        <p class="mt-1">{item.context}</p>
        <p class="mt-3 text-muted-foreground-1">{item.summary}</p>

        {item.stack.length > 0 && (
          <ul class="mt-auto flex flex-wrap gap-x-2 gap-y-1 pt-4 text-xs text-muted-foreground-1">
            {item.stack.map((tech, index) => {
              const icon = brandIcon(tech);
              const last = index === item.stack.length - 1;
              return (
                <li class="inline-flex items-center gap-x-1">
                  {icon && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="size-3 shrink-0">
                      <path d={icon} />
                    </svg>
                  )}
                  <span>{last ? tech : `${tech},`}</span>
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </article>
  )
}

<script>
  function initCardRepoMenus() {
    document.querySelectorAll<HTMLElement>("[data-card-repo-menu]").forEach((menu) => {
      if (menu.dataset.menuBound === "true") return;
      menu.dataset.menuBound = "true";

      const toggle = menu.querySelector<HTMLButtonElement>("[data-card-repo-toggle]");
      const panel = menu.querySelector<HTMLElement>("[data-card-repo-panel]");
      if (!toggle || !panel) return;

      const close = () => {
        toggle.setAttribute("aria-expanded", "false");
        panel.classList.add("hidden");
      };

      toggle.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        panel.classList.toggle("hidden", open);
      });

      document.addEventListener("click", (event) => {
        if (!menu.contains(event.target as Node)) close();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") close();
      });
    });
  }

  initCardRepoMenus();
  document.addEventListener("astro:page-load", initCardRepoMenus);
</script>

