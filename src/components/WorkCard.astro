---
import type { WorkItem } from "../data/work";
import { brandIcon } from "../lib/brand-icons";
import { link } from "../lib/ui";
import Icon from "./Icon.astro";

interface Props {
  item: WorkItem;
  /**
   * `tile`: the image alone, linking to the item on `/work`. For the home page.
   * `card`: image, year, title, context, summary, stack and links.
   */
  variant?: "tile" | "card";
  headingLevel?: 2 | 3;
  /** Anchor id, for `/work#<slug>` links. */
  id?: string;
}

const { item, variant = "card", headingLevel = 2, id } = Astro.props;
const Heading = `h${headingLevel}` as const;

// The generated SVG mockups are drawn with their own margins on a transparent
// canvas, so they are shown whole. A real screenshot or photo fills the frame.
const fit = item.image.endsWith(".svg") ? "object-contain" : "object-cover";
---

{
  variant === "tile" ? (
    <a
      href={`/work#${item.slug}`}
      title={item.title}
      class="group relative block aspect-37/30 overflow-hidden rounded-lg border border-card-line bg-background-1"
    >
      <img
        src={item.image}
        alt={item.title}
        width="640"
        height="400"
        loading="lazy"
        decoding="async"
        class:list={["size-full", fit]}
      />
      <span
        aria-hidden="true"
        class="absolute inset-0 flex items-end bg-linear-to-t from-black/70 to-black/0 to-60% p-2.5 text-xs font-medium text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
      >
        {item.title}
      </span>
    </a>
  ) : (
    <article id={id} class="flex flex-col overflow-hidden rounded-lg border border-card-line">
      <div class="aspect-16/10 border-b border-card-line bg-background-1">
        <img
          src={item.image}
          alt={`Preview of ${item.title}`}
          width="640"
          height="400"
          loading="lazy"
          decoding="async"
          class:list={["size-full", fit]}
        />
      </div>

      <div class="flex grow flex-col p-4">
        <div class="flex items-center justify-between gap-x-2">
          <p class="text-xs">{item.year}</p>
          {item.repo && (
            <a
              href={item.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-sm text-muted-foreground-1 transition-colors hover:text-foreground"
            >
              <Icon name="github" class="size-3.5 shrink-0" />
              <span class="sr-only">Repository of {item.title} (opens in a new tab)</span>
            </a>
          )}
        </div>

        <Heading class="mt-1 font-medium text-foreground">{item.title}</Heading>
        <p class="mt-1">{item.context}</p>
        <p class="mt-3 text-muted-foreground-1">{item.summary}</p>

        {item.stack.length > 0 && (
          <ul class="mt-auto flex flex-wrap gap-x-2 gap-y-1 pt-4 text-xs text-muted-foreground-1">
            {item.stack.map((tech, index) => {
              const icon = brandIcon(tech);
              const last = index === item.stack.length - 1;
              return (
                <li class="inline-flex items-center gap-x-1">
                  {icon && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="size-3 shrink-0">
                      <path d={icon} />
                    </svg>
                  )}
                  <span>{last ? tech : `${tech},`}</span>
                </li>
              );
            })}
          </ul>
        )}

        {item.url && (
          <p class="flex flex-wrap gap-x-4 pt-3">
            <a href={item.url} target="_blank" rel="noopener noreferrer" class={link}>
              Live site<span class="sr-only"> of {item.title} (opens in a new tab)</span>
            </a>
          </p>
        )}
      </div>
    </article>
  )
}
