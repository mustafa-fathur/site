---
import type { HTMLAttributes } from "astro/types";
import { icons, type IconName } from "../lib/icons";

interface Props extends HTMLAttributes<"svg"> {
  name: IconName;
}

const { name, ...attrs } = Astro.props;
const icon = icons[name];
const solid = "fill" in icon;
---

<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill={solid ? "currentColor" : "none"}
  stroke={solid ? undefined : "currentColor"}
  stroke-width={solid ? undefined : 2}
  stroke-linecap={solid ? undefined : "round"}
  stroke-linejoin={solid ? undefined : "round"}
  {...attrs}
  set:html={solid ? icon.fill : icon.stroke}
/>
