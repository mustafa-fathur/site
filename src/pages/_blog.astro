---
import PageHeader from "../components/PageHeader.astro";
import PostCard from "../components/PostCard.astro";
import { posts } from "../data/posts";
import Base from "../layouts/Base.astro";
---

<Base
  title="Blog"
  description="Articles by Mustafa Fathur Rahman on Google Cloud, backend development and running things in production, in English and Indonesian."
>
  <PageHeader title="Blog">
    Notes on cloud, backend and the things I had to look up twice. Written in English and
    Indonesian.
  </PageHeader>

  {
    posts.length > 0 ? (
      <ul class="mt-8 space-y-10">
        {posts.map((post) => (
          <li>
            <PostCard post={post} variant="full" headingLevel={2} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8">No posts yet.</p>
    )
  }
</Base>
