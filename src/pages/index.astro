---
import { Image } from "astro:assets";
import avatar from "../assets/profile.jpeg"
import CompanyLogo from "../components/CompanyLogo.astro";
import Icon from "../components/Icon.astro";
// import PostCard from "../components/PostCard.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
// import { latestPosts } from "../data/posts";
import { awards, education, experience, links, profile, skills } from "../data/profile";
import { featuredProjects } from "../data/projects";
import Base from "../layouts/Base.astro";
import { brandIcon } from "../lib/brand-icons";
import { link } from "../lib/ui";

// TODO: decide whether to keep the "Get in touch" section. It is switched off at
// the end of this page. To bring it back, restore these imports as well:
//   import ButtonLink from "../components/ButtonLink.astro";
//   import CopyEmail from "../components/CopyEmail.astro";
//   and `contact` from "../data/profile"

const contacts = [links.email, links.linkedin, links.github];
---

<Base>
  {/* 1. Hero */}
  <section aria-labelledby="hero-name" class="pt-10">
    <div class="flex items-center gap-x-3">
      <Image
        src={avatar}
        alt={`Portrait of ${profile.name}`}
        width={64}
        height={64}
        densities={[1, 2, 3]}
        priority
        class="size-16 shrink-0 rounded-full object-cover"
      />
      <div class="min-w-0">
        <h1 id="hero-name" class="text-lg font-medium text-foreground">{profile.name}</h1>
        <p>{profile.role}</p>
      </div>
    </div>

    <div class="mt-8 space-y-3">
      {profile.summary.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {/* 2. Contacts */}
    <ul class="mt-5 space-y-3">
      {
        contacts.map((contact) => {
          const external = contact.href.startsWith("http");
          const hint = external ? `${contact.label}, opens in a new tab` : contact.label;
          return (
            <li class="flex items-center gap-x-2.5">
              <Icon name={contact.icon} class="size-3.5 shrink-0 text-foreground" />
              <a
                href={contact.href}
                class={link}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
              >
                {contact.handle}<span class="sr-only"> ({hint})</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {/* 3. Selected Projects: single-project slider */}
  <Section title="Selected Projects">
    <div
      data-project-slider
      role="region"
      aria-roledescription="carousel"
      aria-label="Selected Projects"
      class="relative"
    >
      <div class="overflow-hidden rounded-xl">
        <ul
          data-project-slider-track
          class="flex transition-transform duration-300 ease-out motion-reduce:transition-none"
        >
          {
            featuredProjects.map((item, index) => (
              <li
                data-project-slide={index}
                aria-hidden={index === 0 ? "false" : "true"}
                class="w-full shrink-0"
              >
                <ProjectCard item={item} variant="tile" />
              </li>
            ))
          }
        </ul>
      </div>

      {/* Previous / Next slide arrows */}
      <button
        type="button"
        data-project-slider-prev
        aria-label="Previous project"
        class="inline-flex size-9 items-center justify-center rounded-full border border-card-line bg-background/90 text-muted-foreground-1 shadow-sm backdrop-blur-xs transition-colors hover:bg-muted-hover hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-primary absolute top-1/2 left-2.5 z-10 -translate-y-1/2 md:-left-12"
      >
        <Icon name="chevronLeft" class="size-4 shrink-0" />
      </button>

      <button
        type="button"
        data-project-slider-next
        aria-label="Next project"
        class="inline-flex size-9 items-center justify-center rounded-full border border-card-line bg-background/90 text-muted-foreground-1 shadow-sm backdrop-blur-xs transition-colors hover:bg-muted-hover hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-primary absolute top-1/2 right-2.5 z-10 -translate-y-1/2 md:-right-12"
      >
        <Icon name="chevronRight" class="size-4 shrink-0" />
      </button>
    </div>

    <div class="mt-4 flex items-center justify-between gap-4">
      <a href="/projects" class={link}>View all projects</a>

      <div class="flex items-center gap-1.5" role="group" aria-label="Choose project slide">
        {
          featuredProjects.map((item, index) => (
            <button
              type="button"
              data-project-slider-dot={index}
              aria-label={`Show ${item.title} (${index + 1} of ${featuredProjects.length})`}
              aria-current={index === 0 ? "true" : "false"}
              class:list={[
                "h-1.5 rounded-full transition-all duration-200",
                index === 0
                  ? "w-4 bg-foreground"
                  : "w-1.5 bg-muted-foreground-1/35 hover:bg-muted-foreground-1/60",
              ]}
            />
          ))
        }
      </div>
    </div>
  </Section>

  {/* 4. Skills: label column, items as an inline list */}
  <Section title="Skills">
    <dl class="space-y-3">
      {
        skills.map((group) => (
          <div class="sm:grid sm:grid-cols-[10.25rem_1fr]">
            <dt class="leading-6 text-muted-foreground-1">{group.label}:</dt>
            <dd class="text-foreground">
              <ul class="flex flex-wrap gap-x-2 leading-6">
                {group.items.map((item, index) => {
                  const icon = brandIcon(item);
                  const last = index === group.items.length - 1;
                  return (
                    <li class="inline-flex items-center gap-x-1.5">
                      {icon && (
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="size-3.5 shrink-0">
                          <path d={icon} />
                        </svg>
                      )}
                      <span>{last ? item : `${item},`}</span>
                    </li>
                  );
                })}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  {/* 5. Experience: timeline with the company logo as the marker */}
  <Section title="Experience">
    <ol>
      {
        experience.map((item) => (
          <li class="group flex gap-x-5">
            <div class="relative shrink-0 after:absolute after:inset-s-3 after:top-8 after:bottom-2 after:w-px after:-translate-x-1/2 after:bg-line-2 group-last:after:hidden">
              <CompanyLogo src={item.logo} />
            </div>

            <div class="min-w-0 grow pb-8 group-last:pb-0">
              <p class="text-xs">{item.period}</p>
              <h3 class="mt-1 font-medium text-foreground">
                {item.role} at {item.org}
              </h3>
              {item.description && <p class="mt-1">{item.description}</p>}
              <ul class="mt-3 list-disc space-y-1.5 ps-7">
                {item.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* 6. Education */}
  <Section title="Education">
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        education.map((item) => (
          <li class="rounded-lg border border-card-line p-4">
            <CompanyLogo src={item.logo} size="md" />
            <p class="mt-3 text-xs">{item.period}</p>
            <h3 class="mt-1 font-medium text-foreground">{item.program}</h3>
            <p class="mt-1">{item.school}</p>
            {(item.detail || item.note) && (
              <p class="mt-1 text-xs text-muted-foreground-1">
                {[item.detail, item.note].filter(Boolean).join(" · ")}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  {/* 7. Awards & Certifications: same rows as Articles */}
  <Section title="Awards & Certifications" id="awards">
    <ul class="space-y-6">
      {
        awards.map((item) => (
          <li class="flex gap-x-5">
            <CompanyLogo src={item.logo} />
            <div class="min-w-0 grow">
              <p class="text-muted-foreground-1">
                {item.date} · {item.type}
              </p>
              <h3 class="mt-2 font-medium text-foreground">{item.title}</h3>
              {item.detail && <p class="mt-1 text-muted-foreground-1">{item.detail}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    /*
      8. Articles
      Restore `PostCard` and `latestPosts` imports in the frontmatter to bring this back.

  <Section title="Articles">
    {
      latestPosts.length > 0 ? (
        <ul class="space-y-10">
          {latestPosts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      ) : (
        <p>No posts yet.</p>
      )
    }
    <p class="mt-10">
      <a href="/blog" class={link}>Read the blog</a>
    </p>
  </Section>
    */
  }

  {
    /*
      9. Get in touch
      TODO: decide whether to keep this section. It is switched off for now (the
      navbar's Contact button mails directly). This is an Astro comment, so none of
      it reaches the built page; restore the imports listed in the frontmatter too.

  <section id="contact" aria-labelledby="contact-heading" class="mt-14">
    <div class="rounded-lg border border-card-line p-4 sm:p-6">
      <h2 id="contact-heading" class="text-base font-medium text-foreground">{contact.heading}</h2>
      <p class="mt-1">{contact.pitch}</p>

      <div class="mt-5 flex flex-wrap gap-2">
        <ButtonLink href={links.email.href} variant="primary">
          <Icon name="mail" class="size-4 shrink-0" />
          Email me
        </ButtonLink>
        <CopyEmail email={profile.email} />
        <ButtonLink href={links.linkedin.href} external>
          <Icon name="linkedin" class="size-4 shrink-0" />
          LinkedIn
        </ButtonLink>
        <ButtonLink href={links.instagram.href} external>
          <Icon name="instagram" class="size-4 shrink-0" />
          Instagram
          <span class="text-muted-foreground-2">{links.instagram.handle}</span>
        </ButtonLink>
      </div>
    </div>
  </section>
    */
  }
</Base>

<script>
  function initProjectSlider() {
    document.querySelectorAll<HTMLElement>("[data-project-slider]").forEach((slider) => {
      if (slider.dataset.sliderBound === "true") return;
      slider.dataset.sliderBound = "true";

      const section = slider.closest("section") ?? slider;
      const track = slider.querySelector<HTMLElement>("[data-project-slider-track]");
      const slides = Array.from(slider.querySelectorAll<HTMLElement>("[data-project-slide]"));
      const prevBtn = slider.querySelector<HTMLButtonElement>("[data-project-slider-prev]");
      const nextBtn = slider.querySelector<HTMLButtonElement>("[data-project-slider-next]");
      const dots = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-project-slider-dot]"));

      if (!track || slides.length === 0) return;

      let currentIndex = 0;
      const total = slides.length;

      const goTo = (index: number) => {
        currentIndex = ((index % total) + total) % total;
        track.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;

        slides.forEach((slide, i) => {
          const active = i === currentIndex;
          slide.setAttribute("aria-hidden", String(!active));
          const trigger = slide.querySelector<HTMLButtonElement>("[data-project-modal-open]");
          if (trigger) trigger.tabIndex = active ? 0 : -1;
        });

        dots.forEach((dot, i) => {
          const active = i === currentIndex;
          dot.setAttribute("aria-current", String(active));
          dot.classList.toggle("w-4", active);
          dot.classList.toggle("bg-foreground", active);
          dot.classList.toggle("w-1.5", !active);
          dot.classList.toggle("bg-muted-foreground-1/35", !active);
          dot.classList.toggle("hover:bg-muted-foreground-1/60", !active);
        });
      };

      goTo(0);

      prevBtn?.addEventListener("click", () => goTo(currentIndex - 1));
      nextBtn?.addEventListener("click", () => goTo(currentIndex + 1));

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => goTo(i));
      });

      slider.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          goTo(currentIndex - 1);
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          goTo(currentIndex + 1);
        }
      });

      let startX = 0;
      let startY = 0;
      let swiping = false;

      track.addEventListener(
        "touchstart",
        (event) => {
          if (event.touches.length !== 1) return;
          startX = event.touches[0].clientX;
          startY = event.touches[0].clientY;
          swiping = true;
        },
        { passive: true },
      );

      track.addEventListener(
        "touchend",
        (event) => {
          if (!swiping || event.changedTouches.length !== 1) return;
          swiping = false;
          const dx = event.changedTouches[0].clientX - startX;
          const dy = event.changedTouches[0].clientY - startY;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            goTo(dx < 0 ? currentIndex + 1 : currentIndex - 1);
          }
        },
        { passive: true },
      );
    });
  }

  initProjectSlider();
  document.addEventListener("astro:page-load", initProjectSlider);
</script>
